# Flask
FLASK_ENV=development
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=festoon_db
MYSQL_USER=root
MYSQL_PASSWORD=
# Set MYSQL_SSL=true for hosted providers like Aiven (required for their free MySQL tier).
# Paste the provider's CA certificate content as MYSQL_SSL_CA_CONTENT (keep it on one line
# with \n for line breaks, since most hosting dashboards don't support multiline env values).
MYSQL_SSL=false
MYSQL_SSL_CA_CONTENT=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Frontend URL (for CORS) - comma-separate multiple origins, e.g. local + deployed
FRONTEND_URL=http://localhost:5173

# Delivery charge (in rupees), used if order subtotal is below free-delivery threshold
DELIVERY_CHARGE=60
FREE_DELIVERY_THRESHOLD=999
